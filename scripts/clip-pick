#!/usr/bin/env bash
# clip-pick — the SUPER+V clipboard history picker (cliphist → fuzzel → wl-copy).
#
#   clip-pick              Open the picker. Enter copies the entry back to the
#                          clipboard (paste-ready).
#     Shift+Delete         Delete the selected entry and reopen the picker
#                          on the same row.
#     Ctrl+Shift+Delete    Wipe the whole history (asks first).
#   clip-pick --print      Print the fuzzel input (with thumbnails) and exit;
#                          for checking the menu without a UI.
#   clip-pick -h|--help    This help.
#
# Options: --db-path PATH  use another cliphist db (testing; default: cliphist's).
#
# Image rows get a thumbnail through fuzzel's rofi icon protocol
# (`line\0icon\x1f/abs/path.png`; not with --dmenu0). Thumbnails live in
# $XDG_RUNTIME_DIR/cliphist-thumbs/, are made once per entry (in parallel, so
# only the first open after many new screenshots is slow) and are pruned when
# their entry is gone. The file name carries the id AND the preview's
# size/type/dims, so an id reused after a wipe can't show a stale picture.
# fuzzel draws icons at line height, hence the taller --line-height.
#
# The delete/wipe keys are fuzzel custom-5/custom-6 (exit 14/15), set with
# --override here so no other picker sees them; Shift+Delete is fuzzel's
# `expunge` by default (launcher cache only, unused in dmenu), so it's unmapped.
#
# Exit: 0 copied, cancelled or deleted/wiped; 1 a tool failed; 2 usage.
set -uo pipefail

usage() { sed -n '2,/^set -uo/{/^set -uo/d;s/^# \{0,1\}//;p}' "$0"; }

dbpath=
print_only=0
while (($#)); do
    case $1 in
        -h|--help) usage; exit 0 ;;
        --print) print_only=1 ;;
        --db-path) [[ $# -ge 2 ]] || { echo "clip-pick: --db-path needs a path" >&2; exit 2; }
                   dbpath=$2; shift ;;
        *) echo "clip-pick: unknown argument: $1 (see --help)" >&2; exit 2 ;;
    esac
    shift
done

for tool in cliphist fuzzel wl-copy magick; do
    command -v "$tool" >/dev/null || { echo "clip-pick: $tool not found" >&2; exit 1; }
done

thumbs="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR unset}/cliphist-thumbs"
mkdir -p "$thumbs" && chmod 700 "$thumbs" || exit 1

ch() { cliphist ${dbpath:+-db-path "$dbpath"} "$@"; }

# Thumbnail for one image row: $1 id, $2 output path. Called from xargs.
make_thumb() {
    local tmp="$2.tmp.$$"
    if cliphist ${dbpath:+-db-path "$dbpath"} decode "$1" |
        magick - -thumbnail 128x128 "png:$tmp" 2>/dev/null; then
        mv -f "$tmp" "$2"
    else
        rm -f "$tmp"
    fi
}

# Fill lines[] (cliphist rows) and icons[] (thumbnail path or "") from cliphist list.
build() {
    lines=() icons=()
    local -A keep=()
    local -a todo=()
    local line id preview t
    while IFS= read -r line; do
        id=${line%%$'\t'*}
        preview=${line#*$'\t'}
        lines+=("$line")
        if [[ $preview =~ ^\[\[\ binary\ data\ ([0-9.]+)\ ([A-Za-z]+)\ ([a-z0-9+.-]+)\ ([0-9]+x[0-9]+)\ \]\]$ ]]; then
            t="$thumbs/$id-${BASH_REMATCH[1]}${BASH_REMATCH[2]}-${BASH_REMATCH[3]}-${BASH_REMATCH[4]}.png"
            keep[$t]=1
            [[ -s $t ]] || todo+=("$id" "$t")
            icons+=("$t")
        else
            icons+=("")
        fi
    done < <(ch list)

    if ((${#todo[@]})); then
        export -f make_thumb
        export dbpath
        # shellcheck disable=SC2016  # $1/$2 are the child bash's
        printf '%s\0' "${todo[@]}" |
            xargs -0 -n2 -P "$(nproc)" bash -c 'make_thumb "$1" "$2"' _
    fi

    # Prune thumbnails whose entry is gone (deleted, trimmed by -max-items, wiped).
    for t in "$thumbs"/*.png; do
        [[ -e $t && -z ${keep[$t]:-} ]] && rm -f "$t"
    done
}

# The fuzzel input. bash strings can't hold NUL, so the icon suffix is added here.
menu() {
    local i
    for i in "${!lines[@]}"; do
        if [[ -n ${icons[i]} ]]; then
            printf '%s\0icon\x1f%s\n' "${lines[i]}" "${icons[i]}"
        else
            printf '%s\n' "${lines[i]}"
        fi
    done
}

pick() { # $1 = row to preselect
    menu | fuzzel --dmenu --index --only-match \
        --prompt 'clip  ' --width=70 --lines=10 --line-height=32 --with-nth=2 \
        --select-index="$1" \
        --override key-bindings.expunge=none \
        --override key-bindings.custom-5=Shift+Delete \
        --override key-bindings.custom-6=Control+Shift+Delete
}

confirm_wipe() {
    local n=$1 ans
    ans=$(printf 'no, keep it\nyes, wipe all %s entries\n' "$n" |
        fuzzel --dmenu --only-match --lines=2 --width=40 --prompt 'wipe clipboard history? ')
    [[ $ans == yes* ]]
}

build
if ((print_only)); then
    menu
    exit 0
fi

sel=0
while :; do
    ((${#lines[@]})) || exit 0
    idx=$(pick "$sel"); rc=$?
    [[ $idx =~ ^[0-9]+$ ]] && ((idx < ${#lines[@]})) || idx=
    case $rc in
        0)  [[ -n $idx ]] || exit 0
            printf '%s\n' "${lines[idx]}" | ch decode | wl-copy || exit 1
            exit 0 ;;
        14) [[ -n $idx ]] || exit 0
            printf '%s\n' "${lines[idx]}" | ch delete || exit 1
            sel=$idx
            build
            ((sel < ${#lines[@]})) || sel=$((${#lines[@]} - 1)) ;;
        15) if confirm_wipe "${#lines[@]}"; then
                ch wipe || exit 1
                rm -f "$thumbs"/*.png
                exit 0
            fi
            sel=${idx:-0} ;;
        *)  exit 0 ;;   # Esc (2), focus loss, other custom keys
    esac
done
