#!/usr/bin/env bash
# Reset every dwindle split on the active workspace to even (ratio 1.0),
# i.e. force all windows back to their dwindle-calculated sizes.
# layoutmsg splitratio acts on the focused window's split, so visit each
# tiled window in one hyprctl batch, then restore the original focus.
set -euo pipefail

ws=$(hyprctl activeworkspace -j | jq -r '.id')
orig=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' || true)

batch=""
while read -r addr; do
    batch+="dispatch hl.dsp.focus({ window = \"address:$addr\" }) ; dispatch hl.dsp.layout(\"splitratio 1.0 exact\") ; "
done < <(hyprctl clients -j |
    jq -r --argjson ws "$ws" \
       '.[] | select(.workspace.id == $ws and .floating == false) | .address')

[ -n "$orig" ] && batch+="dispatch hl.dsp.focus({ window = \"address:$orig\" })"
batch="${batch% ; }"
[ -n "$batch" ] && hyprctl --batch "$batch" >/dev/null
