#!/usr/bin/env bash
# scratchpad — drop-down terminal on the special workspace (SUPER+`).
#
#   scratchpad          show/hide it; start it first if it isn't running
#   scratchpad -h|--help   print this help
#
# The window is kitty with class `scratchpad` (conf/rules.lua: floating 900x600, centred, `special silent`)
# attached to tmux's `scratch` session — the same one as tmux `prefix t`, so the shell keeps its state
# across toggles and restarts. SUPER+SHIFT+` still moves any window onto the special workspace.
set -uo pipefail

usage() { awk 'NR == 1 { next } !/^#/ { exit } /^#   / { u = 1 } u && /^#$/ { exit } { sub(/^# ?/, ""); print }' "$0"; }
case ${1:-} in
    "") ;;
    -h|--help) usage; exit 0 ;;
    *) echo "scratchpad: unexpected argument '$1'" >&2; usage >&2; exit 2 ;;
esac

toggle() { hyprctl dispatch 'hl.dsp.workspace.toggle_special("special")' >/dev/null; }

if ! hyprctl clients -j | jq -e 'any(.[]; .class == "scratchpad")' >/dev/null; then
    hyprctl dispatch 'hl.dsp.exec_cmd("kitty --class scratchpad -e tmux new-session -A -s scratch")' >/dev/null
    # the rule maps it onto special *silently*: show special unless it's already open on this monitor
    open=$(hyprctl monitors -j | jq -r 'map(select(.focused))[0].specialWorkspace.name // ""')
    [[ $open == special:special ]] || toggle
    exit 0
fi
toggle
