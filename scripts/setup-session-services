#!/usr/bin/env bash
# Idempotent per-machine setup for the systemd-managed session daemons.
# See docs/systemd-session.md. Safe to rerun after adding units.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)

# Custom target: linked (no [Install] section), started by autostart.
systemctl --user link --force "$repo/systemd/hyprland-session.target"

# Failure reporting: the OnFailure= template and the check service are linked (no [Install]); the timer
# (after login + hourly: failed system and user units) is enabled below.
systemctl --user link --force \
  "$repo/systemd/unit-failed-notify@.service" \
  "$repo/systemd/failed-units-check.service"

# Drop-in for the packaged fnott.service: restart after a compositor crash (systemctl can't link drop-ins).
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fnott.service.d"
ln -sfn "$repo/systemd/fnott.service.d/restart.conf" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fnott.service.d/restart.conf"

# Drop-in for the packaged hypridle.service: save a crashed Hyprland's log on hypridle's restart.
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/hypridle.service.d"
ln -sfn "$repo/systemd/hypridle.service.d/crash-logs.conf" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/hypridle.service.d/crash-logs.conf"

# Repo units: enable by absolute path so symlinks point into the repo.
systemctl --user enable --force \
  "$repo/systemd/cliphist-text.service" \
  "$repo/systemd/cliphist-image.service" \
  "$repo/systemd/nextcloud-client.service" \
  "$repo/systemd/failed-units-check.timer"

# No polkit agent on purpose: systemctl/pkexec/udisksctl prompt in the terminal
# (their built-in pkttyagent fallback); GUI-only admin tools just get "not authorized".
systemctl --user disable hyprpolkitagent.service polkit-agent.service 2>/dev/null || true

# Package-shipped units.
systemctl --user enable fnott.service hypridle.service

if command -v hyprsunset >/dev/null; then
    systemctl --user enable hyprsunset.service
else
    echo "WARNING: hyprsunset not installed — skipping (sudo pacman -S hyprsunset)" >&2
fi

systemctl --user daemon-reload
echo "done — relogin, or follow the live-takeover steps in docs/systemd-session.md"
