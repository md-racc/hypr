#!/usr/bin/env bash
# Idempotent per-machine setup for the systemd-managed session daemons.
# See docs/systemd-session.md. Safe to rerun after adding units.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)

# Custom target: linked (no [Install] section), started by autostart.
systemctl --user link --force "$repo/systemd/hyprland-session.target"

# Repo units: enable by absolute path so symlinks point into the repo.
systemctl --user enable --force \
  "$repo/systemd/cliphist-text.service" \
  "$repo/systemd/cliphist-image.service" \
  "$repo/systemd/nextcloud-client.service" \
  "$repo/systemd/polkit-agent.service"

# polkit-agent.service (fuzzel, needs AUR cmd-polkit-git) replaces hyprpolkitagent
systemctl --user disable hyprpolkitagent.service 2>/dev/null || true
command -v cmd-polkit-agent >/dev/null ||
    echo "WARNING: cmd-polkit-agent not installed — polkit prompts won't work (paru -S cmd-polkit-git)" >&2

# Package-shipped units.
systemctl --user enable fnott.service hypridle.service

if command -v hyprsunset >/dev/null; then
    systemctl --user enable hyprsunset.service
else
    echo "WARNING: hyprsunset not installed — skipping (sudo pacman -S hyprsunset)" >&2
fi

systemctl --user daemon-reload
echo "done — relogin, or follow the live-takeover steps in docs/systemd-session.md"
