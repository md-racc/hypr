#!/usr/bin/env bash
# Focus a window picked from a fuzzel list. Uses a single clients
# snapshot and fuzzel --index so duplicate class/title lines still
# resolve to the window that was actually selected.
set -euo pipefail

clients=$(hyprctl clients -j)
idx=$(jq -r '.[] | "\(.class): \(.title)"' <<<"$clients" | fuzzel --dmenu --index) || exit 0
[ -z "$idx" ] && exit 0

addr=$(jq -r --argjson i "$idx" '.[$i].address' <<<"$clients")
[ -n "$addr" ] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })"
