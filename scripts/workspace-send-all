#!/bin/bash
# Usage: workspace-send-all <target-workspace>
# Moves all windows on the active workspace to the target workspace.

target=$1
[ -n "$target" ] || { echo "usage: workspace-send-all <target-workspace>" >&2; exit 1; }
current=$(hyprctl activeworkspace -j | jq -r '.id')

hyprctl clients -j \
  | jq -r --argjson cws "$current" '.[] | select(.workspace.id == $cws) | .address' \
  | while read -r addr; do
      hyprctl dispatch "hl.dsp.window.move({ workspace = \"$target\", window = \"address:$addr\", silent = true })"
    done

hyprctl dispatch "hl.dsp.focus({ workspace = \"$target\" })"
