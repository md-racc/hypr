[Unit]
Description=Polkit authentication agent (fuzzel, scripts/polkit-agent)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# only one agent can register per session
Conflicts=hyprpolkitagent.service

[Service]
ExecStart=%h/.config/hypr/scripts/polkit-agent
Slice=session.slice
Restart=on-failure

[Install]
WantedBy=graphical-session.target
